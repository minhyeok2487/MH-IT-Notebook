---
import Sidebar from '../components/Sidebar.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  activeCategory?: string;
  activeSubcategory?: string;
}
const { title, activeCategory, activeSubcategory } = Astro.props;
const pageTitle = title ? `${title} — MH IT Notebook` : "MH IT Notebook — 네트워크 엔지니어링 저널";
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{pageTitle}</title>
  <ClientRouter />
</head>
<body>
  <div class="wrap">
    <nav transition:name="site-nav" transition:persist>
      <a class="logo" href="/">MH IT Notebook</a>
      <div class="navlinks">
        <a href="/">글</a>
        <a href="/">소개</a>
      </div>
    </nav>

    <div class="layout-grid">
      <div transition:animate="none">
        <Sidebar activeCategory={activeCategory} activeSubcategory={activeSubcategory} />
      </div>
      <main class="main-col" transition:animate="fade">
        <slot />
      </main>
    </div>

    <footer>
      <span>© 2026 MH IT Notebook</span>
    </footer>
  </div>
</body>
</html>

<style is:global>
:root{
  --paper:#faf9f5; --paper2:#f2efe6; --ink:#1c1b17; --ink-dim:#726c62; --ink-faint:#a49d90;
  --line:#e6e1d3; --accent:#b5602f;
  --tag-routing:#6f7a5c; --tag-security:#8a5a6b; --tag-switch:#4f6f80;
  --serif:Georgia,"Iowan Old Style","Palatino Linotype",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif;
  --mono:"Cascadia Code","Consolas",monospace;
}
@media (prefers-color-scheme: dark){
  :root{
    --paper:#181713; --paper2:#201f1a; --ink:#eeeae0; --ink-dim:#a39c8e; --ink-faint:#726c60;
    --line:#2c2a22; --accent:#d98a55;
    --tag-routing:#9aa885; --tag-security:#c48ea1; --tag-switch:#7fa3b8;
  }
}
:root[data-theme="dark"]{
  --paper:#181713; --paper2:#201f1a; --ink:#eeeae0; --ink-dim:#a39c8e; --ink-faint:#726c60;
  --line:#2c2a22; --accent:#d98a55;
  --tag-routing:#9aa885; --tag-security:#c48ea1; --tag-switch:#7fa3b8;
}
:root[data-theme="light"]{
  --paper:#faf9f5; --paper2:#f2efe6; --ink:#1c1b17; --ink-dim:#726c62; --ink-faint:#a49d90;
  --line:#e6e1d3; --accent:#b5602f;
  --tag-routing:#6f7a5c; --tag-security:#8a5a6b; --tag-switch:#4f6f80;
}

*{box-sizing:border-box}
html{scrollbar-gutter:stable; overflow-y:scroll}
html,body{margin:0;padding:0}
body{
  background:var(--paper); color:var(--ink); font-family:var(--sans);
  line-height:1.6; -webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none}
.wrap{max-width:1080px;margin:0 auto;padding:0 28px}

.wrap > nav{
  display:flex; align-items:center; justify-content:space-between; gap:20px;
  padding:26px 0; border-bottom:1px solid var(--line); margin-bottom:8px;
}
.logo{font-family:var(--serif);font-size:19px;font-weight:700;letter-spacing:.01em}
.navlinks{display:flex;gap:26px;font-size:13.5px;color:var(--ink-dim)}
.navlinks a:hover{color:var(--ink)}

.layout-grid{
  display:grid; grid-template-columns:190px minmax(0,1fr); gap:56px;
  align-items:start;
}
.sidebar{
  position:sticky; top:26px; padding:8px 0 32px;
  border-right:1px solid var(--line);
}
.main-col{ min-width:0; max-width:760px; }

@media (max-width:800px){
  .layout-grid{grid-template-columns:1fr}
  .sidebar{
    position:static; border-right:none; border-bottom:1px solid var(--line);
    padding:20px 0;
  }
  .tree{flex-direction:row;flex-wrap:wrap;gap:4px 18px}
  .cat{margin-bottom:0}
  .subs{padding-left:14px}
}

.hero{padding:20px 0 32px}
.hero .kicker{
  font-family:var(--mono); font-size:11.5px; letter-spacing:.1em; text-transform:uppercase;
  color:var(--accent); margin-bottom:16px;
}
.hero h1{
  font-family:var(--serif); font-weight:400; font-size:40px; line-height:1.25;
  letter-spacing:-.005em; margin:0 0 18px; max-width:15ch; text-wrap:balance;
}
.hero p{ font-size:16.5px; color:var(--ink-dim); max-width:56ch; margin:0; }

.list{padding:8px 0 60px}
.post{
  display:grid; grid-template-columns:104px 1fr; gap:28px;
  padding:34px 0; border-top:1px solid var(--line);
}
.post:last-child{border-bottom:1px solid var(--line)}
.post .date{ font-family:var(--mono); font-size:12px; color:var(--ink-faint); padding-top:3px; }
.post h2{
  font-family:var(--serif); font-weight:400; font-size:22px; line-height:1.35;
  margin:0 0 10px; text-wrap:balance;
}
.post h2 a:hover{color:var(--accent)}
.tagrow{display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
.tag{ font-family:var(--sans); font-size:11.5px; font-weight:600; letter-spacing:.03em; }
.tag.routing{color:var(--tag-routing)}
.tag.switch{color:var(--tag-switch)}
.tag.security{color:var(--tag-security)}
.post p.excerpt{ font-size:15px; color:var(--ink-dim); max-width:58ch; margin:0; }

.crumb{
  font-family:var(--mono); font-size:12px; color:var(--ink-faint);
  padding:24px 0 0; letter-spacing:.02em;
}
.crumb a:hover{color:var(--accent)}

article.full{padding:24px 0 60px}
article.full h1{
  font-family:var(--serif); font-weight:400; font-size:34px; line-height:1.3;
  margin:14px 0 16px; text-wrap:balance;
}
article.full .meta{
  font-size:12.5px; color:var(--ink-faint); margin-bottom:34px;
  display:flex; gap:14px; align-items:center; flex-wrap:wrap;
}
article.full .body{ font-size:16.5px; max-width:720px; }
article.full .body h2{
  font-family:var(--serif); font-weight:700; font-size:22px; margin:38px 0 14px;
}
article.full .body p{ margin:0 0 18px; color:var(--ink); }
article.full .body blockquote{
  margin:22px 0; padding:2px 0 2px 18px; border-left:3px solid var(--accent);
  color:var(--ink-dim); font-style:italic;
}
article.full .body code{
  font-family:var(--mono); font-size:.9em; background:var(--paper2);
  padding:1px 6px; border-radius:4px;
}
article.full .body pre{
  overflow-x:auto; background:var(--paper2); border:1px solid var(--line);
  border-radius:8px; padding:14px 16px; margin:0 0 18px;
}
article.full .body pre code{ background:none; padding:0; }
article.full .body img{
  display:block; max-width:100%; height:auto; margin:24px 0;
  border:1px solid var(--line); border-radius:8px;
}
article.full .body table{
  width:100%; border-collapse:collapse; margin:0 0 18px; font-size:14.5px;
  display:block; overflow-x:auto;
}
article.full .body th, article.full .body td{
  border:1px solid var(--line); padding:8px 12px; text-align:left;
}
article.full .body th{ background:var(--paper2); font-weight:600; }
article.full .body strong{color:var(--ink)}

footer{
  border-top:1px solid var(--line); padding:26px 0 50px;
  display:flex; justify-content:space-between; font-size:12.5px; color:var(--ink-faint);
}

@media (max-width:560px){
  .post{grid-template-columns:1fr;gap:8px}
  .post .date{order:-1}
  .hero h1{font-size:32px}
  article.full h1{font-size:27px}
}
</style>
