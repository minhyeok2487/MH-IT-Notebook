---
import { getCollection } from 'astro:content';
import { slugify } from '../lib/slug';

interface Props {
  activeCategory?: string;
  activeSubcategory?: string;
}
const { activeCategory, activeSubcategory } = Astro.props;

const posts = await getCollection('posts');

// 목차는 2depth까지만: category -> subcategory[]
const tree = new Map<string, Set<string>>();
for (const post of posts) {
  const { category, subcategory } = post.data;
  if (!tree.has(category)) tree.set(category, new Set());
  if (subcategory) tree.get(category)!.add(subcategory);
}
const categories = [...tree.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<aside class="sidebar">
  <nav class="tree">
    <a
      href="/"
      class:list={['cat-link', 'all', { active: !activeCategory }]}
    >전체 글</a>
    {categories.map(([category, subs]) => (
      <div class="cat">
        <a
          href={`/category/${slugify(category)}/`}
          class:list={['cat-link', { active: activeCategory === category && !activeSubcategory }]}
        >{category}</a>
        {subs.size > 0 && (
          <ul class="subs">
            {[...subs].sort().map((sub) => (
              <li>
                <a
                  href={`/category/${slugify(category)}/${slugify(sub)}/`}
                  class:list={['sub-link', { active: activeCategory === category && activeSubcategory === sub }]}
                >{sub}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </nav>
</aside>

<style>
.sidebar{ font-family:var(--sans); }
.tree{display:flex;flex-direction:column;gap:2px}
.cat{margin-bottom:4px}
.cat-link{
  display:block; font-size:14.5px; font-weight:700; line-height:1.3; color:var(--ink); padding:4px 0;
}
.cat-link.all{color:var(--ink);margin-bottom:12px}
.cat-link:hover{color:var(--accent)}
.cat-link.active{color:var(--accent)}
.subs{
  list-style:none; margin:2px 0 6px 7px; padding:2px 0 2px 15px;
  border-left:1px solid var(--line);
}
.sub-link{
  display:block; font-size:13px; font-weight:400; line-height:1.3; color:var(--ink-faint); padding:3px 0;
}
.sub-link:hover{color:var(--ink-dim)}
.sub-link.active{color:var(--accent); font-weight:600}
</style>
